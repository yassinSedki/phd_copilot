# Secrets for the local kind cluster. Copy to .env.k8s (gitignored) and fill in,
# then: make k8s-secret
#
# Only SECRET values belong here. Non-secret config lives in the Helm chart's
# values.yaml → ConfigMap.

DATABASE_URL=postgresql+psycopg2://phd:phd@postgres:5432/phd
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
COHERE_API_KEY=
SMTP__PASSWORD=
