# ===== phd-copilot env. Copy to .env and fill in. =========================

# --- Auth ----------------------------------------------------------------
# Auth is email/password only — no Google/OAuth sign-in.
JWT_SECRET=change-me-to-a-32+byte-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200

# --- Database (PostgreSQL — Supabase or any hosted Postgres) -------------
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
# Supabase example (pooler port 6543, sslmode required):
#   postgresql+psycopg2://postgres.PROJECTREF:PASSWORD@aws-X-XX-X.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# --- Frontend --------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173

# --- Outbound email (reference-request / supervisor-outreach "Send") -----
# One shared relay account used for every user — the message's Reply-To is
# set to the sending user's own contact email, so replies land in their
# inbox even though it was relayed through this address. Without this set,
# the app runs fine but "Send" 409s with a friendly message and users fall
# back to "Copy email". Gmail example: an App Password (not your normal
# password) at myaccount.google.com/apppasswords, with 2FA enabled.
SMTP__HOST=
SMTP__PORT=587
SMTP__USERNAME=
SMTP__PASSWORD=
SMTP__FROM_EMAIL=
SMTP__USE_TLS=true

# --- LLM (Cohere) --------------------------------------------------------
# Provider switch — stub | anthropic | cohere
LLM__PROVIDER=cohere
COHERE_API_KEY=
# Or set LLM__API_KEY directly. Either works.
# LLM__API_KEY=

LLM__DEFAULT_MODEL=command-a-03-2025
LLM__MAX_TOKENS=2048
LLM__REQUEST_TIMEOUT=60

# Per-role overrides (any subset). Format: LLM__ROLE_MODELS__<role>=<model>
# LLM__ROLE_MODELS__SCORER=command-r-08-2024
# LLM__ROLE_MODELS__DRAFTER=command-a-03-2025
# LLM__TEMPERATURE_DRAFTER=0.3
# extractor already defaults to 8192 (it emits one full JSON object per
# listing on the scraped page — pages with many listings need the headroom).
# LLM__ROLE_MAX_TOKENS__EXTRACTOR=8192

# --- Embeddings (Cohere) -------------------------------------------------
EMBEDDING__PROVIDER=cohere
EMBEDDING__MODEL=embed-english-v3.0
EMBEDDING__DIM=1024
EMBEDDING__BATCH_SIZE=96
EMBEDDING__CACHE_SIZE=1000
# EMBEDDING__API_KEY=    # falls back to COHERE_API_KEY above

# --- Pipeline --------------------------------------------------------------
# One model handles all scoring now (Phase 13 removed the cheap-then-strong
# rescorer — LLM__ROLE_MODELS__SCORER_STRONG no longer exists).
DEFAULT_SCORE_THRESHOLD=60
LOW_SCORE_THRESHOLD=40
BATCH_SIZE=5
MAX_PAGES_PER_URL=10

# --- Storage -------------------------------------------------------------
STORAGE_DIR=./storage
