# ===== phd-copilot env. Copy to .env and fill in. =========================

# --- Auth ----------------------------------------------------------------
JWT_SECRET=change-me-to-a-32+byte-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200

# --- Database (PostgreSQL — Supabase or any hosted Postgres) -------------
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
# Supabase example (pooler port 6543, sslmode required):
#   postgresql+psycopg2://postgres.PROJECTREF:PASSWORD@aws-X-XX-X.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# --- LLM (Cohere) --------------------------------------------------------
# Provider switch — stub | anthropic | cohere
LLM__PROVIDER=cohere
COHERE_API_KEY=
# Or set LLM__API_KEY directly. Either works.
# LLM__API_KEY=

LLM__DEFAULT_MODEL=command-a-03-2025
LLM__MAX_TOKENS=2048
LLM__REQUEST_TIMEOUT=60

# Per-role overrides (any subset). Format: LLM__ROLE_MODELS__<role>=<model>
# LLM__ROLE_MODELS__SCORER=command-r-08-2024
# LLM__ROLE_MODELS__DRAFTER=command-a-03-2025
# LLM__TEMPERATURE_DRAFTER=0.3

# --- Embeddings (Cohere) -------------------------------------------------
EMBEDDING__PROVIDER=cohere
EMBEDDING__MODEL=embed-english-v3.0
EMBEDDING__DIM=1024
EMBEDDING__BATCH_SIZE=96
EMBEDDING__CACHE_SIZE=1000
# EMBEDDING__API_KEY=    # falls back to COHERE_API_KEY above

# --- Pipeline ------------------------------------------------------------
DEFAULT_SCORE_THRESHOLD=70
LOW_SCORE_THRESHOLD=40
BATCH_SIZE=5
MAX_PAGES_PER_URL=10

# --- Storage -------------------------------------------------------------
STORAGE_DIR=./storage

# --- Scheduler (off by default; turn on when you wire a real scraper) ----
DAILY_RUN=off
DAILY_RUN_HOUR=6
DAILY_RUN_MINUTE=0
